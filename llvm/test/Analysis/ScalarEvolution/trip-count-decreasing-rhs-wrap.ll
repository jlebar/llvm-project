; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py
; RUN: opt < %s -disable-output "-passes=print<scalar-evolution>" 2>&1 | FileCheck %s

; The exit count of an `icmp ult %iv, %rhs` exit where %rhs is itself a
; decreasing addrec is only computable when %rhs cannot wrap in the domain
; of the comparison.  Here %neg = {0,+,-2}<nsw> wraps unsigned on the first
; step (0 -> -2 == 2^64-2), so `%iz ugt %neg` would first hold at
; i > 2^64/3, far beyond the i32 latch bound -- the early exit is never
; taken, not taken after 1 backedge: nsw must not be accepted as a
; no-wrap guarantee for an unsigned comparison.
define i64 @rhs_addrec_nsw_only_unsigned_cmp(i32 %n) {
; CHECK-LABEL: 'rhs_addrec_nsw_only_unsigned_cmp'
; CHECK-NEXT:  Classifying expressions for: @rhs_addrec_nsw_only_unsigned_cmp
; CHECK-NEXT:    %i = phi i32 [ 0, %entry ], [ %inc, %latch ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,-2147483648) S: [0,-2147483648) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %acc = phi i64 [ 0, %entry ], [ %acc2, %latch ]
; CHECK-NEXT:    --> {0,+,7}<nuw><nsw><%loop> U: [0,30064771066) S: [0,30064771066) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iz = zext nneg i32 %i to i64
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,4294967296) S: [0,4294967296) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %i2 = shl nuw nsw i32 %i, 1
; CHECK-NEXT:    --> {0,+,2}<nuw><nsw><%loop> U: [0,-2147483648) S: [0,2147483647) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %i2z = zext nneg i32 %i2 to i64
; CHECK-NEXT:    --> {0,+,2}<nuw><nsw><%loop> U: [0,8589934591) S: [0,8589934591) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %neg = sub nsw i64 0, %i2z
; CHECK-NEXT:    --> {0,+,-2}<nsw><%loop> U: [0,-1) S: [-8589934590,1) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %acc2 = add i64 %acc, 7
; CHECK-NEXT:    --> {7,+,7}<nuw><nsw><%loop> U: [7,30064771073) S: [7,30064771073) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %inc = add nuw nsw i32 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><%loop> U: [1,0) S: [1,0) Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @rhs_addrec_nsw_only_unsigned_cmp
; CHECK-NEXT:  Loop %loop: <multiple exits> Unpredictable backedge-taken count.
; CHECK-NEXT:    exit count for loop: ***COULDNOTCOMPUTE***
; CHECK-NEXT:    exit count for latch: (-1 + %n)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 4294967295
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (zext i32 (-1 + %n) to i64)
; CHECK-NEXT:    symbolic max exit count for loop: i64 -1
; CHECK-NEXT:    symbolic max exit count for latch: (-1 + %n)
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %inc, %latch ]
  %acc = phi i64 [ 0, %entry ], [ %acc2, %latch ]
  %iz = zext nneg i32 %i to i64
  %i2 = shl nuw nsw i32 %i, 1
  %i2z = zext nneg i32 %i2 to i64
  %neg = sub nsw i64 0, %i2z
  %early = icmp ugt i64 %iz, %neg
  br i1 %early, label %exit, label %latch

latch:
  %acc2 = add i64 %acc, 7
  %inc = add nuw nsw i32 %i, 1
  %cond = icmp ne i32 %inc, %n
  br i1 %cond, label %loop, label %exit2

exit:
  ret i64 1

exit2:
  ret i64 %acc2
}

; Signed comparison against an nsw decreasing rhs: still computable.
define void @rhs_addrec_nsw_signed_cmp(ptr %p) {
; CHECK-LABEL: 'rhs_addrec_nsw_signed_cmp'
; CHECK-NEXT:  Classifying expressions for: @rhs_addrec_nsw_signed_cmp
; CHECK-NEXT:    %i = phi i64 [ 0, %entry ], [ %inc, %loop ]
; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,34) S: [0,34) Exits: 33 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %r = phi i64 [ 100, %entry ], [ %rdec, %loop ]
; CHECK-NEXT:    --> {100,+,-2}<nsw><%loop> U: [34,101) S: [34,101) Exits: 34 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %inc = add nuw nsw i64 %i, 1
; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,35) S: [1,35) Exits: 34 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %rdec = add nsw i64 %r, -2
; CHECK-NEXT:    --> {98,+,-2}<nsw><%loop> U: [32,99) S: [32,99) Exits: 32 LoopDispositions: { %loop: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @rhs_addrec_nsw_signed_cmp
; CHECK-NEXT:  Loop %loop: backedge-taken count is i64 33
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 33
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i64 33
; CHECK-NEXT:  Loop %loop: Trip multiple is 34
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %loop ]
  %r = phi i64 [ 100, %entry ], [ %rdec, %loop ]
  store i64 %i, ptr %p
  %inc = add nuw nsw i64 %i, 1
  %rdec = add nsw i64 %r, -2
  %c = icmp slt i64 %inc, %rdec
  br i1 %c, label %loop, label %exit

exit:
  ret void
}
