; CHECK-NEXT:    [[Z3_PRE_PHI:%.*]] = phi i32 [ [[DOTPRE2]], %[[OTHER]] ], [ [[Z2_PRE_PHI]], %[[MERGE]] ]
; CHECK-NEXT:    ret i32 [[Z3_PRE_PHI]]
;
entry:
