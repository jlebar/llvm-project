; CHECK-NEXT:    store i32 [[S1]], ptr @G, align 4
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[PRE]]:
; CHECK-NEXT:    [[DOTPRE:%.*]] = zext i8 [[V]] to i32
; CHECK-NEXT:    [[DOTPRE1:%.*]] = select i1 [[COND2]], i32 0, i32 [[DOTPRE]]
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[S2_PRE_PHI:%.*]] = phi i32 [ [[DOTPRE1]], %[[PRE]] ], [ [[S1]], %[[BB]] ]
; CHECK-NEXT:    [[Z2_PRE_PHI:%.*]] = phi i32 [ [[DOTPRE]], %[[PRE]] ], [ [[Z1]], %[[BB]] ]
