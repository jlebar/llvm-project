; PRE of %z2 inserts a clone of it on the %entry -> %merge edge.  The clone
; must not keep %z2's nneg: the phi built from it becomes the leader that
; replaces the later flag-free %z3, whose users are NOT poison-tolerant
; (%z2's own poison never escaped its select).
define i32 @test3(i8 %v, i1 %cond, i1 %cond2) {
; CHECK-LABEL: define i32 @test3(
; CHECK-SAME: i8 [[V:%.*]], i1 [[COND:%.*]], i1 [[COND2:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[COND]], label %[[BB:.*]], label %[[ENTRY_MERGE_CRIT_EDGE:.*]]
; CHECK:       [[ENTRY_MERGE_CRIT_EDGE]]:
; CHECK-NEXT:    [[DOTPRE:%.*]] = zext i8 [[V]] to i32
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[BB]]:
; CHECK-NEXT:    [[Z1:%.*]] = zext i8 [[V]] to i32
; CHECK-NEXT:    store i32 [[Z1]], ptr @G, align 4
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[Z2_PRE_PHI:%.*]] = phi i32 [ [[DOTPRE]], %[[ENTRY_MERGE_CRIT_EDGE]] ], [ [[Z1]], %[[BB]] ]
; CHECK-NEXT:    [[S:%.*]] = select i1 [[COND2]], i32 0, i32 [[Z2_PRE_PHI]]
; CHECK-NEXT:    store i32 [[S]], ptr @H, align 4
; CHECK-NEXT:    ret i32 [[Z2_PRE_PHI]]
;
entry:
  br i1 %cond, label %bb, label %merge

bb:
  %z1 = zext i8 %v to i32
  store i32 %z1, ptr @G, align 4
  br label %merge

merge:
  %z2 = zext nneg i8 %v to i32
  %s = select i1 %cond2, i32 0, i32 %z2
  store i32 %s, ptr @H, align 4
  %z3 = zext i8 %v to i32
  ret i32 %z3
}
