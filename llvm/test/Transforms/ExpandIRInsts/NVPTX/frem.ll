; The approximate expansion computes 16-bit frem in f32: the quotient of two
; finite 16-bit values easily overflows the narrow type (half 1000.0 / half
; 0.01 is ~1e5 > f16-max 65504), and trunc(inf) would cascade to an inf/NaN
; result. An f32 quotient of two halfs cannot overflow (|f16 / f16| <= 2^40);
; a bf16 quotient still can, but only for the exponent-extreme inputs for
; which an f32 / f32 quotient overflows too.
define half @frem_f16_afn(half %a, half %b) {
; CHECK-LABEL: define half @frem_f16_afn(
; CHECK-SAME: half [[A:%.*]], half [[B:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = fpext half [[A]] to float
; CHECK-NEXT:    [[TMP2:%.*]] = fpext half [[B]] to float
; CHECK-NEXT:    [[TMP3:%.*]] = fdiv float [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[TMP4:%.*]] = call float @llvm.trunc.f32(float [[TMP3]])
; CHECK-NEXT:    [[TMP5:%.*]] = fneg float [[TMP4]]
; CHECK-NEXT:    [[TMP6:%.*]] = call float @llvm.fma.f32(float [[TMP5]], float [[TMP2]], float [[TMP1]])
; CHECK-NEXT:    [[R:%.*]] = fptrunc float [[TMP6]] to half
; CHECK-NEXT:    ret half [[R]]
;
  %r = frem afn half %a, %b
  ret half %r
}

