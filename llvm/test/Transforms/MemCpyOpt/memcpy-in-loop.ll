declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)
declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ptr noalias nocapture readonly, i64, i1 immarg)

; A noalias scope declared inside a loop only relates accesses within a
; single execution of the loop body. The MemorySSA clobber walk that finds
; the source dependency of a memcpy crosses loop backedges, so it must not
; use such scopes to skip accesses from other iterations.

@a = global [4 x i8] zeroinitializer
@b = constant [4 x i8] c"\07\08\09\0A"
@out = global [4 x i8] zeroinitializer

; With %cs = {1, 0}, %ps = {@a, undef}, %n = 2: iteration 0 stores 42 through
; %p == @a; iteration 1 copies @a into @out, so @out[0] must be 42. This is
; well-defined: no iteration executes both the !alias.scope store and the
; !noalias memcpy, so no scope instance's noalias claim is violated.
; Forwarding the second memcpy to copy from @b would lose the store.
define void @cross_iteration(ptr noalias %cs, ptr noalias %ps, i64 %n) {
; CHECK-LABEL: @cross_iteration(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 @a, ptr align 4 @b, i64 4, i1 false)
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[INC:%.*]], [[LATCH:%.*]] ]
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0:![0-9]+]])
; CHECK-NEXT:    [[CP:%.*]] = getelementptr inbounds i8, ptr [[CS:%.*]], i64 [[I]]
; CHECK-NEXT:    [[C:%.*]] = load i8, ptr [[CP]], align 1
; CHECK-NEXT:    [[TOBOOL:%.*]] = icmp eq i8 [[C]], 1
; CHECK-NEXT:    br i1 [[TOBOOL]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    [[PP:%.*]] = getelementptr inbounds ptr, ptr [[PS:%.*]], i64 [[I]]
; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr [[PP]], align 8
; CHECK-NEXT:    store i8 42, ptr [[P]], align 1, !alias.scope [[META0]]
; CHECK-NEXT:    br label [[LATCH]]
; CHECK:       else:
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 @out, ptr align 4 @a, i64 4, i1 false), !noalias [[META0]]
; CHECK-NEXT:    br label [[LATCH]]
; CHECK:       latch:
; CHECK-NEXT:    [[INC]] = add i64 [[I]], 1
; CHECK-NEXT:    [[COND:%.*]] = icmp ult i64 [[INC]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[COND]], label [[LOOP]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 @a, ptr align 4 @b, i64 4, i1 false)
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %latch ]
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  %cp = getelementptr inbounds i8, ptr %cs, i64 %i
  %c = load i8, ptr %cp, align 1
  %tobool = icmp eq i8 %c, 1
  br i1 %tobool, label %then, label %else

then:
  %pp = getelementptr inbounds ptr, ptr %ps, i64 %i
  %p = load ptr, ptr %pp, align 8
  store i8 42, ptr %p, align 1, !alias.scope !2
  br label %latch

else:
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 @out, ptr align 4 @a, i64 4, i1 false), !noalias !2
  br label %latch

latch:
  %inc = add i64 %i, 1
  %cond = icmp ult i64 %inc, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret void
}

; Here the store and both memcpys execute in the same iteration, i.e. within
; a single instance of the scope, where the noalias claim does apply (if %p
; aliased @a, the same-instance store/memcpy overlap would be UB). The
; forwarding must be preserved.
define void @same_iteration(ptr noalias %ps, i64 %n) {
; CHECK-LABEL: @same_iteration(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[INC:%.*]], [[LOOP]] ]
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0]])
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 @a, ptr align 4 @b, i64 4, i1 false)
; CHECK-NEXT:    [[PP:%.*]] = getelementptr inbounds ptr, ptr [[PS:%.*]], i64 [[I]]
; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr [[PP]], align 8
; CHECK-NEXT:    store i8 42, ptr [[P]], align 1, !alias.scope [[META0]]
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 @out, ptr align 4 @b, i64 4, i1 false)
; CHECK-NEXT:    [[INC]] = add i64 [[I]], 1
; CHECK-NEXT:    [[COND:%.*]] = icmp ult i64 [[INC]], [[N:%.*]]
; CHECK-NEXT:    br i1 [[COND]], label [[LOOP]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %loop ]
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 @a, ptr align 4 @b, i64 4, i1 false)
  %pp = getelementptr inbounds ptr, ptr %ps, i64 %i
  %p = load ptr, ptr %pp, align 8
  store i8 42, ptr %p, align 1, !alias.scope !2
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 @out, ptr align 4 @a, i64 4, i1 false), !noalias !2
  %inc = add i64 %i, 1
  %cond = icmp ult i64 %inc, %n
  br i1 %cond, label %loop, label %exit

exit:
  ret void
}

; An irreducible cycle re-executes its blocks like a loop body, but LoopInfo
; has no Loop for it: %left and %right form a cycle with two entries. The
; scope declared in %left is instance-local to each pass through the cycle,
; so the memcpy in %right must not be forwarded across it either.
define void @irreducible(ptr noalias %ps, i1 %e, i1 %e2) {
; CHECK-LABEL: @irreducible(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 @a, ptr align 4 @b, i64 4, i1 false)
; CHECK-NEXT:    br i1 [[E:%.*]], label [[LEFT:%.*]], label [[RIGHT:%.*]]
; CHECK:       left:
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0]])
; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr [[PS:%.*]], align 8
; CHECK-NEXT:    store i8 42, ptr [[P]], align 1, !alias.scope [[META0]]
; CHECK-NEXT:    br label [[RIGHT]]
; CHECK:       right:
; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr align 4 @out, ptr align 4 @a, i64 4, i1 false), !noalias [[META0]]
; CHECK-NEXT:    br i1 [[E2:%.*]], label [[LEFT]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 @a, ptr align 4 @b, i64 4, i1 false)
  br i1 %e, label %left, label %right

left:
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  %p = load ptr, ptr %ps, align 8
  store i8 42, ptr %p, align 1, !alias.scope !2
  br label %right

right:
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 @out, ptr align 4 @a, i64 4, i1 false), !noalias !2
  br i1 %e2, label %left, label %exit

exit:
  ret void
}

declare void @llvm.experimental.noalias.scope.decl(metadata)

!0 = !{!0, !"dom"}
!1 = !{!1, !0, !"scope"}
!2 = !{!1}
