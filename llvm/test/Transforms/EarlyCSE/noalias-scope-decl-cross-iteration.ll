; Scoped alias metadata referencing a scope declared by an
; llvm.experimental.noalias.scope.decl INSIDE a loop is only valid within one
; iteration. EarlyCSE's MemorySSA-based generation check must not use it to
; step across an intervening store: the store may execute in a different
; iteration, where the noalias claim does not hold.

@q = global i32 0

declare void @llvm.experimental.noalias.scope.decl(metadata)
declare i32 @readonly_callee(ptr) memory(read)

; The pre-loop store of 7 must not be forwarded to the load: with ps[0] == @q
; and cs = {1, 0}, iteration 0 stores 1 to @q through %p (legal: that
; iteration accesses @q only through %p), and iteration 1 must load 1.
define i32 @cross_iteration(ptr %ps, ptr %cs, i32 %n) {
; CHECK-LABEL: define i32 @cross_iteration(
; CHECK-SAME: ptr [[PS:%.*]], ptr [[CS:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    store i32 7, ptr @q, align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0:![0-9]+]])
; CHECK-NEXT:    [[PP:%.*]] = getelementptr inbounds ptr, ptr [[PS]], i32 [[I]]
; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr [[PP]], align 8
; CHECK-NEXT:    [[CP:%.*]] = getelementptr inbounds i32, ptr [[CS]], i32 [[I]]
; CHECK-NEXT:    [[C:%.*]] = load i32, ptr [[CP]], align 4
; CHECK-NEXT:    [[CTOB:%.*]] = icmp ne i32 [[C]], 0
; CHECK-NEXT:    br i1 [[CTOB]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i32 1, ptr [[P]], align 4, !alias.scope [[META0]]
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr @q, align 4, !noalias [[META0]]
; CHECK-NEXT:    [[ACC_ELSE:%.*]] = add i32 [[ACC]], [[V]]
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[ACC_NEXT]] = phi i32 [ [[ACC]], %[[THEN]] ], [ [[ACC_ELSE]], %[[ELSE]] ]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[CONT:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CONT]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[ACC_NEXT]]
;
entry:
  store i32 7, ptr @q
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %latch ]
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  %pp = getelementptr inbounds ptr, ptr %ps, i32 %i
  %p = load ptr, ptr %pp
  %cp = getelementptr inbounds i32, ptr %cs, i32 %i
  %c = load i32, ptr %cp
  %ctob = icmp ne i32 %c, 0
  br i1 %ctob, label %then, label %else

then:
  store i32 1, ptr %p, !alias.scope !2
  br label %latch

else:
  %v = load i32, ptr @q, !noalias !2
  %acc.else = add i32 %acc, %v
  br label %latch

latch:
  %acc.next = phi i32 [ %acc, %then ], [ %acc.else, %else ]
  %i.next = add nuw nsw i32 %i, 1
  %cont = icmp slt i32 %i.next, %n
  br i1 %cont, label %loop, label %exit

exit:
  ret i32 %acc.next
}

; The pre-loop call must not be CSE'd with the in-loop call: with %p == %q,
; an earlier iteration's store through %p changes what a later iteration's
; call reads.
define i32 @cross_iteration_call(ptr %p, ptr %q, i32 %n) {
; CHECK-LABEL: define i32 @cross_iteration_call(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[V0:%.*]] = call i32 @readonly_callee(ptr [[Q]])
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0]])
; CHECK-NEXT:    [[PARITY:%.*]] = and i32 [[I]], 1
; CHECK-NEXT:    [[CTOB:%.*]] = icmp ne i32 [[PARITY]], 0
; CHECK-NEXT:    br i1 [[CTOB]], label %[[THEN:.*]], label %[[ELSE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i32 1, ptr [[P]], align 4, !alias.scope [[META0]]
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[ELSE]]:
; CHECK-NEXT:    [[V:%.*]] = call i32 @readonly_callee(ptr [[Q]]), !noalias [[META0]]
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[ACC_NEXT]] = phi i32 [ [[ACC]], %[[THEN]] ], [ [[V]], %[[ELSE]] ]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[CONT:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CONT]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[R:%.*]] = add i32 [[ACC_NEXT]], [[V0]]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  %v0 = call i32 @readonly_callee(ptr %q)
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %latch ]
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  %parity = and i32 %i, 1
  %ctob = icmp ne i32 %parity, 0
  br i1 %ctob, label %then, label %else

then:
  store i32 1, ptr %p, !alias.scope !2
  br label %latch

else:
  %v = call i32 @readonly_callee(ptr %q), !noalias !2
  br label %latch

latch:
  %acc.next = phi i32 [ %acc, %then ], [ %v, %else ]
  %i.next = add nuw nsw i32 %i, 1
  %cont = icmp slt i32 %i.next, %n
  br i1 %cont, label %loop, label %exit

exit:
  %r = add i32 %acc.next, %v0
  ret i32 %r
}

; Same-iteration forwarding across the scoped store would be sound (the store
; and the load are in the same scope instance), but EarlyCSE cannot separate
; the walk's same-iteration skips from cross-iteration ones, so it now
; conservatively refuses whenever the metadata's scope is declared inside a
; cycle.
define i32 @same_iteration_conservative(ptr %p, ptr %q, i32 %n) {
; CHECK-LABEL: define i32 @same_iteration_conservative(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0]])
; CHECK-NEXT:    store i32 7, ptr [[Q]], align 4, !noalias [[META0]]
; CHECK-NEXT:    store i32 1, ptr [[P]], align 4, !alias.scope [[META0]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[Q]], align 4, !noalias [[META0]]
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[CONT:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CONT]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 [[V]]
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  store i32 7, ptr %q, !noalias !2
  store i32 1, ptr %p, !alias.scope !2
  %v = load i32, ptr %q, !noalias !2
  %i.next = add nuw nsw i32 %i, 1
  %cont = icmp slt i32 %i.next, %n
  br i1 %cont, label %loop, label %exit

exit:
  %v.lcssa = phi i32 [ %v, %loop ]
  ret i32 %v.lcssa
}

; A declaration outside any loop only ever produces one scope instance, so
; forwarding across the store through %p is still fine.
define i32 @straightline(ptr %p, ptr %q) {
; MSSA-LABEL: define i32 @straightline(
; MSSA-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
; MSSA-NEXT:  [[ENTRY:.*:]]
; MSSA-NEXT:    store i32 7, ptr [[Q]], align 4
; MSSA-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0]])
; MSSA-NEXT:    store i32 1, ptr [[P]], align 4, !alias.scope [[META0]]
; MSSA-NEXT:    ret i32 7
;
; SIMPLE-LABEL: define i32 @straightline(
; SIMPLE-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
; SIMPLE-NEXT:  [[ENTRY:.*:]]
; SIMPLE-NEXT:    store i32 7, ptr [[Q]], align 4
; SIMPLE-NEXT:    call void @llvm.experimental.noalias.scope.decl(metadata [[META0]])
; SIMPLE-NEXT:    store i32 1, ptr [[P]], align 4, !alias.scope [[META0]]
; SIMPLE-NEXT:    [[V:%.*]] = load i32, ptr [[Q]], align 4, !noalias [[META0]]
; SIMPLE-NEXT:    ret i32 [[V]]
;
entry:
  store i32 7, ptr %q
  call void @llvm.experimental.noalias.scope.decl(metadata !2)
  store i32 1, ptr %p, !alias.scope !2
  %v = load i32, ptr %q, !noalias !2
  ret i32 %v
}

