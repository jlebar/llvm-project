; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -mtriple=nvptx64-nvidia-cuda -passes=load-store-vectorizer -S -o - %s | FileCheck %s

; getConstantOffsetComplexAddrs proves the two narrow indices differ by
; IdxDiff, then multiplies IdxDiff by the element stride to get the byte
; distance.  The multiply must be done at the pointer index width: at the
; narrow (i32) index width, IdxDiff = 2^30 times stride 4 wraps to 0, making
; two loads that are 2^32 bytes apart look like the same address.
;
; SCEV can't prove the flagless adds don't overflow (the assume has no context
; instruction there), so the i32 tests go through the known-bits path.

declare void @llvm.assume(i1)

@table = private constant [4 x i64] [i64 0, i64 1, i64 2, i64 3]

define void @sext_wrap_to_zero(ptr %base, i32 %x, ptr %out) {
; CHECK-LABEL: define void @sext_wrap_to_zero(
; CHECK-SAME: ptr [[BASE:%.*]], i32 [[X:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i32 [[X]], 256
; CHECK-NEXT:    call void @llvm.assume(i1 [[CMP]])
; CHECK-NEXT:    [[B:%.*]] = add i32 [[X]], 1073741824
; CHECK-NEXT:    [[SX:%.*]] = sext i32 [[X]] to i64
; CHECK-NEXT:    [[SB:%.*]] = sext i32 [[B]] to i64
; CHECK-NEXT:    [[GEPA:%.*]] = getelementptr inbounds i32, ptr [[BASE]], i64 [[SX]]
; CHECK-NEXT:    [[GEPB:%.*]] = getelementptr inbounds i32, ptr [[BASE]], i64 [[SB]]
; CHECK-NEXT:    [[L1:%.*]] = load i32, ptr [[GEPA]], align 8
; CHECK-NEXT:    [[L2:%.*]] = load i32, ptr [[GEPB]], align 4
; CHECK-NEXT:    store i32 [[L1]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[OUT2:%.*]] = getelementptr i32, ptr [[OUT]], i64 1
; CHECK-NEXT:    store i32 [[L2]], ptr [[OUT2]], align 4
; CHECK-NEXT:    ret void
;
  %cmp = icmp ult i32 %x, 256
  call void @llvm.assume(i1 %cmp)
  %b = add i32 %x, 1073741824       ; x + 2^30, no nsw
  %sx = sext i32 %x to i64
  %sb = sext i32 %b to i64
  %gepA = getelementptr inbounds i32, ptr %base, i64 %sx
  %gepB = getelementptr inbounds i32, ptr %base, i64 %sb
  %l1 = load i32, ptr %gepA, align 8
  %l2 = load i32, ptr %gepB, align 4
  store i32 %l1, ptr %out
  %out2 = getelementptr i32, ptr %out, i64 1
  store i32 %l2, ptr %out2
  ret void
}

