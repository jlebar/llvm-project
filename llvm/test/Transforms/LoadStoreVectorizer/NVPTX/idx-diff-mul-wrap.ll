; SimplifyCFG switch lookup tables index the table with the switch
; condition's own type, so the index can be narrower than the stride: with an
; i2 index and stride 8, even IdxDiff = -1 wraps to 0 in the i2 multiply
; (-1 * 8 == -8 == 0 mod 4), and the two table loads look like the same
; address.  No large constants involved, and a different no-wrap proof: SCEV
; computes the singleton IdxDiff ((t+1) - (t^-2) == -1 mod 4), and the
; SCEV unsigned-range check proves safety from t being a two-bit
; sign-extension ({0,-1}), where known bits see nothing through trunc(ashr).
; With the fix the loads are correctly seen 8 bytes apart; they stay scalar
; only because NVPTX rejects the 16-byte access at align 8 -- the property
; under test is that both loads survive.

define void @zext_i2_switch_table(i16 %x, ptr %out) {
; CHECK-LABEL: define void @zext_i2_switch_table(
; CHECK-SAME: i16 [[X:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[S:%.*]] = ashr i16 [[X]], 15
; CHECK-NEXT:    [[T:%.*]] = trunc i16 [[S]] to i2
; CHECK-NEXT:    [[A:%.*]] = xor i2 [[T]], -2
; CHECK-NEXT:    [[ZA:%.*]] = zext i2 [[A]] to i64
; CHECK-NEXT:    [[GEPA:%.*]] = getelementptr [8 x i8], ptr @table, i64 [[ZA]]
; CHECK-NEXT:    [[LA:%.*]] = load i64, ptr [[GEPA]], align 8
; CHECK-NEXT:    [[B:%.*]] = add i2 [[T]], 1
; CHECK-NEXT:    [[ZB:%.*]] = zext i2 [[B]] to i64
; CHECK-NEXT:    [[GEPB:%.*]] = getelementptr [8 x i8], ptr @table, i64 [[ZB]]
; CHECK-NEXT:    [[LB:%.*]] = load i64, ptr [[GEPB]], align 8
; CHECK-NEXT:    store i64 [[LA]], ptr [[OUT]], align 8
; CHECK-NEXT:    [[OUT2:%.*]] = getelementptr i8, ptr [[OUT]], i64 8
; CHECK-NEXT:    store i64 [[LB]], ptr [[OUT2]], align 8
; CHECK-NEXT:    ret void
;
  %s = ashr i16 %x, 15
  %t = trunc i16 %s to i2
  %a = xor i2 %t, -2
  %za = zext i2 %a to i64
  %gepA = getelementptr [8 x i8], ptr @table, i64 %za
  %la = load i64, ptr %gepA, align 8
  %b = add i2 %t, 1
  %zb = zext i2 %b to i64
  %gepB = getelementptr [8 x i8], ptr @table, i64 %zb
  %lb = load i64, ptr %gepB, align 8
  store i64 %la, ptr %out
  %out2 = getelementptr i8, ptr %out, i64 8
  store i64 %lb, ptr %out2
  ret void
}

