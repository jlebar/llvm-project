; CHECK:       # %bb.0:
; CHECK-NEXT:    vpcmpeqd {{\.?LCPI[0-9]+_[0-9]+}}(%rip){1to4}, %xmm0, %k1
; CHECK-NEXT:    vpcmpeqd %xmm0, %xmm0, %xmm0
; CHECK-NEXT:    vmovdqu8 {{.*#+}} xmm0 {%k1} = [251,252,253,254,u,u,u,u,u,u,u,u,u,u,u,u]
; CHECK-NEXT:    vpsrlw $8, %xmm0, %xmm1
; CHECK-NEXT:    vpminub %xmm1, %xmm0, %xmm0
; CHECK-NEXT:    vphminposuw %xmm0, %xmm0
; CHECK-NEXT:    vmovd %xmm0, %eax
; CHECK-NEXT:    addb $5, %al
; CHECK-NEXT:    movzbl %al, %eax
; CHECK-NEXT:    retq
  %m = icmp eq <4 x i32> %x, splat (i32 42)
  %r = call i64 @llvm.experimental.cttz.elts.i64.v4i1(<4 x i1> %m, i1 false)
  ret i64 %r
}


