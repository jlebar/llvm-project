; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=x86_64-unknown-unknown -mattr=+avx512f,+avx512vl,+avx512bw,+avx512dq < %s | FileCheck %s

; With AVX512 the i1 mask types are legal but the i8 step vectors used by the
; CTTZ_ELTS expansion are not (v8i8 widens to v16i8). An all-false mask must
; return the element count of the original mask type (8/4), not that of the
; widened step vector (16).

define i64 @ctz_v8i1(<8 x i8> %x) {
; CHECK-LABEL: ctz_v8i1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vpcmpeqb {{\.?LCPI[0-9]+_[0-9]+}}(%rip), %xmm0, %k0
; CHECK-NEXT:    kmovb %k0, %k1
; CHECK-NEXT:    vpcmpeqd %xmm0, %xmm0, %xmm0
; CHECK-NEXT:    vmovdqu8 {{.*#+}} xmm0 {%k1} = [247,248,249,250,251,252,253,254,u,u,u,u,u,u,u,u]
; CHECK-NEXT:    vpsrlw $8, %xmm0, %xmm1
; CHECK-NEXT:    vpminub %xmm1, %xmm0, %xmm0
; CHECK-NEXT:    vphminposuw %xmm0, %xmm0
; CHECK-NEXT:    vmovd %xmm0, %eax
; CHECK-NEXT:    addb $9, %al
; CHECK-NEXT:    movzbl %al, %eax
; CHECK-NEXT:    retq
  %m = icmp eq <8 x i8> %x, splat (i8 42)
  %r = call i64 @llvm.experimental.cttz.elts.i64.v8i1(<8 x i1> %m, i1 false)
  ret i64 %r
}


define i64 @ctz_v4i1(<4 x i32> %x) {
