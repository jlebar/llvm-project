# RUN: llc -mtriple=x86_64-- -run-pass=machine-cse -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-- -passes=machine-cse %s -o - | FileCheck %s

# X86 twin of AArch64/machine-cse-flags.mir: the CSE survivor keeps a
# wrap flag only if the absorbed twin also carried it.
---
name: nsw_dominates_plain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi, $esi
    ; CHECK-LABEL: name: nsw_dominates_plain
    ; CHECK: liveins: $edi, $esi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gr32 = COPY $esi
    ; CHECK-NEXT: [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
    ; CHECK-NEXT: [[XOR32rr:%[0-9]+]]:gr32 = XOR32rr [[ADD32rr]], [[ADD32rr]], implicit-def dead $eflags
    ; CHECK-NEXT: $eax = COPY [[XOR32rr]]
    ; CHECK-NEXT: RET 0, $eax
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = nsw ADD32rr %0, %1, implicit-def dead $eflags
    %3:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    %4:gr32 = XOR32rr %2, %3, implicit-def dead $eflags
    $eax = COPY %4
    RET 0, $eax
...
---
name: both_nsw_keep_nsw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi, $esi
    ; CHECK-LABEL: name: both_nsw_keep_nsw
    ; CHECK: liveins: $edi, $esi
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gr32 = COPY $edi
