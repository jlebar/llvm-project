# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=machine-cse -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -passes=machine-cse %s -o - | FileCheck %s

# MachineCSE's value numbering ignores MI flags, so instructions that differ
# only in nsw/nuw/... or fast-math flags still merge. The surviving def may
# then only keep the flags both twins had: its value now flows into the
# absorbed twin's users, and flag-consuming transforms (e.g. AArch64's
# SUBS-based compare elision, which fires on NoSWrap) must not see promises
# the twin never made.
---
name: nsw_dominates_plain
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: nsw_dominates_plain
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
  ; CHECK-NEXT:   [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[COPY]], [[COPY1]]
  ; CHECK-NEXT:   CBZW [[ADDWrr]], %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   $w0 = COPY [[ADDWrr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $w0 = COPY [[ADDWrr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = nsw ADDWrr %0, %1
    CBZW %2, %bb.2

  bb.1:
    %3:gpr32 = ADDWrr %0, %1
    $w0 = COPY %3
    RET_ReallyLR implicit $w0

  bb.2:
    $w0 = COPY %2
    RET_ReallyLR implicit $w0
...
---
name: plain_dominates_nsw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: plain_dominates_nsw
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[EORWrr:%[0-9]+]]:gpr32 = EORWrr [[ADDWrr]], [[ADDWrr]]
    ; CHECK-NEXT: $w0 = COPY [[EORWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = ADDWrr %0, %1
    %3:gpr32 = nsw ADDWrr %0, %1
    %4:gpr32 = EORWrr %2, %3
    $w0 = COPY %4
    RET_ReallyLR implicit $w0
...
---
name: both_nsw_keep_nsw
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0, $w1
    ; CHECK-LABEL: name: both_nsw_keep_nsw
    ; CHECK: liveins: $w0, $w1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $w0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
    ; CHECK-NEXT: [[ADDWrr:%[0-9]+]]:gpr32 = nsw ADDWrr [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[EORWrr:%[0-9]+]]:gpr32 = EORWrr [[ADDWrr]], [[ADDWrr]]
    ; CHECK-NEXT: $w0 = COPY [[EORWrr]]
    ; CHECK-NEXT: RET_ReallyLR implicit $w0
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = nsw ADDWrr %0, %1
    %3:gpr32 = nsw ADDWrr %0, %1
    %4:gpr32 = EORWrr %2, %3
    $w0 = COPY %4
    RET_ReallyLR implicit $w0
...
---
name: fmf_intersect
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s0, $s1
    ; CHECK-LABEL: name: fmf_intersect
    ; CHECK: liveins: $s0, $s1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:fpr32 = COPY $s0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:fpr32 = COPY $s1
    ; CHECK-NEXT: [[FADDSrr:%[0-9]+]]:fpr32 = nnan nofpexcept FADDSrr [[COPY]], [[COPY1]], implicit $fpcr
    ; CHECK-NEXT: [[FADDSrr1:%[0-9]+]]:fpr32 = nofpexcept FADDSrr [[FADDSrr]], [[FADDSrr]], implicit $fpcr
    ; CHECK-NEXT: $s0 = COPY [[FADDSrr1]]
    ; CHECK-NEXT: RET_ReallyLR implicit $s0
    %0:fpr32 = COPY $s0
    %1:fpr32 = COPY $s1
    %2:fpr32 = nnan ninf nsz nofpexcept FADDSrr %0, %1, implicit $fpcr
    %3:fpr32 = nnan contract nofpexcept FADDSrr %0, %1, implicit $fpcr
    %4:fpr32 = nofpexcept FADDSrr %2, %3, implicit $fpcr
    $s0 = COPY %4
    RET_ReallyLR implicit $s0
...
