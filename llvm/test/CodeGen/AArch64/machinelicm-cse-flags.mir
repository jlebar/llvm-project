# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=early-machinelicm -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=aarch64 -passes=early-machinelicm %s -o - | FileCheck %s

# MachineLICM CSEs a hoisted instruction with an identical one already in the
# preheader, ignoring MI flags. The surviving def may then only keep the
# flags both instructions had: its value now flows into the absorbed
# instruction's users, which never got those promises. Here the plain MADDWrrr
# hoisted out of the loop is CSEd with the preheader's nsw MADDWrrr, which must
# lose its nsw.
---
name: licm_cse_drops_nsw
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: licm_cse_drops_nsw
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64sp = COPY $x2
  ; CHECK-NEXT:   [[MADDWrrr:%[0-9]+]]:gpr32 = MADDWrrr [[COPY]], [[COPY1]], $wzr
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr32 = PHI [[MADDWrrr]], %bb.0, %5, %bb.1
  ; CHECK-NEXT:   STRWui [[MADDWrrr]], [[COPY2]], 0 :: (store (s32))
  ; CHECK-NEXT:   [[ADDWrr:%[0-9]+]]:gpr32 = nuw ADDWrr [[PHI]], [[COPY]]
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    liveins: $w0, $w1, $x2
    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr64sp = COPY $x2
    %3:gpr32 = nsw MADDWrrr %0, %1, $wzr
    B %bb.1

  bb.1:
    %4:gpr32 = PHI %3, %bb.0, %6, %bb.1
    %5:gpr32 = MADDWrrr %0, %1, $wzr
    STRWui %5, %2, 0 :: (store (s32))
    %6:gpr32 = nuw ADDWrr %4, %0
    B %bb.1

  bb.2:
    RET_ReallyLR
...
