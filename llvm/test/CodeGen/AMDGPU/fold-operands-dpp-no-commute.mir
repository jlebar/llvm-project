# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-fold-operands -verify-machineinstrs -o - %s | FileCheck %s

# The DPP swizzle only applies to src0, so folding must not commute DPP
# instructions: op(dpp(a), b) is not op(dpp(b), a).

---
name: no_commute_sgpr_to_dpp_src0
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0

    ; CHECK-LABEL: name: no_commute_sgpr_to_dpp_src0
    ; CHECK: liveins: $sgpr0, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[V_ADD_F32_e64_dpp:%[0-9]+]]:vgpr_32 = V_ADD_F32_e64_dpp [[DEF]], 0, [[COPY2]], 0, [[COPY1]], 0, 0, 1, 15, 15, 1, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_ADD_F32_e64_dpp]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:sgpr_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    %2:vgpr_32 = COPY %0
    %3:vgpr_32 = IMPLICIT_DEF
    %4:vgpr_32 = V_ADD_F32_e64_dpp %3, 0, %2, 0, %1, 0, 0, 1, 15, 15, 1, implicit $mode, implicit $exec
    $vgpr0 = COPY %4
    S_ENDPGM 0, implicit $vgpr0
...

---
name: no_commute_imm_to_dpp_src0
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: no_commute_imm_to_dpp_src0
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 1065353216, implicit $exec
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[V_ADD_F32_e64_dpp:%[0-9]+]]:vgpr_32 = V_ADD_F32_e64_dpp [[DEF]], 0, [[V_MOV_B32_e32_]], 0, [[COPY]], 0, 0, 1, 15, 15, 1, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_ADD_F32_e64_dpp]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_MOV_B32_e32 1065353216, implicit $exec
    %2:vgpr_32 = IMPLICIT_DEF
    %3:vgpr_32 = V_ADD_F32_e64_dpp %2, 0, %1, 0, %0, 0, 0, 1, 15, 15, 1, implicit $mode, implicit $exec
    $vgpr0 = COPY %3
    S_ENDPGM 0, implicit $vgpr0
...

# Folding into src1 in place (no commute) is still fine.
---
name: fold_sgpr_to_dpp_src1
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0, $vgpr0

    ; CHECK-LABEL: name: fold_sgpr_to_dpp_src1
    ; CHECK: liveins: $sgpr0, $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:sgpr_32 = COPY $sgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[V_ADD_F32_e64_dpp:%[0-9]+]]:vgpr_32 = V_ADD_F32_e64_dpp [[DEF]], 0, [[COPY1]], 0, [[COPY]], 0, 0, 1, 15, 15, 1, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_ADD_F32_e64_dpp]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:sgpr_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    %2:vgpr_32 = COPY %0
    %3:vgpr_32 = IMPLICIT_DEF
    %4:vgpr_32 = V_ADD_F32_e64_dpp %3, 0, %1, 0, %2, 0, 0, 1, 15, 15, 1, implicit $mode, implicit $exec
    $vgpr0 = COPY %4
    S_ENDPGM 0, implicit $vgpr0
...

# The identity quad_perm reads each lane's own src0, so commuting is safe
# there and the commute-to-fold still fires.
---
name: commute_imm_to_dpp_src0_identity_quad_perm
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0

    ; CHECK-LABEL: name: commute_imm_to_dpp_src0_identity_quad_perm
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
    ; CHECK-NEXT: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; CHECK-NEXT: [[V_ADD_F32_e64_dpp:%[0-9]+]]:vgpr_32 = V_ADD_F32_e64_dpp [[DEF]], 0, [[COPY]], 0, 1065353216, 0, 0, 228, 15, 15, 1, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr0 = COPY [[V_ADD_F32_e64_dpp]]
    ; CHECK-NEXT: S_ENDPGM 0, implicit $vgpr0
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_MOV_B32_e32 1065353216, implicit $exec
    %2:vgpr_32 = IMPLICIT_DEF
    %3:vgpr_32 = V_ADD_F32_e64_dpp %2, 0, %1, 0, %0, 0, 0, 228, 15, 15, 1, implicit $mode, implicit $exec
    $vgpr0 = COPY %3
    S_ENDPGM 0, implicit $vgpr0
...
