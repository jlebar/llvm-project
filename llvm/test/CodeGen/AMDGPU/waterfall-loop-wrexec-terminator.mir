# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -mattr=+wavefrontsize32 -verify-machineinstrs --run-pass=si-fix-sgpr-copies -o - %s | FileCheck --check-prefix=W32 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -mattr=+wavefrontsize64 -verify-machineinstrs --run-pass=si-fix-sgpr-copies -o - %s | FileCheck --check-prefix=W64 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -mattr=+wavefrontsize32 -verify-machineinstrs --run-pass=si-fix-sgpr-copies,livevars,phi-node-elimination -o - %s | FileCheck --check-prefix=PHIELIM32 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1010 -mattr=+wavefrontsize64 -verify-machineinstrs --run-pass=si-fix-sgpr-copies,livevars,phi-node-elimination -o - %s | FileCheck --check-prefix=PHIELIM64 %s

# The waterfall loop's EXEC update must be a terminator: everything register
# allocation inserts before a block's first terminator has to execute under
# the current iteration's EXEC mask, not the next iteration's todo mask.
# Check that the update is emitted as the S_ANDN2_WREXEC_*_term terminator
# directly before SI_WATERFALL_LOOP, and that PHI elimination folds the exec
# PHI into the terminator's def instead of inserting a COPY after it.

---
name:            waterfall_wrexec_term
tracksRegLiveness: true
liveins:
  - { reg: '$vgpr0', virtual-reg: '%0' }
  - { reg: '$vgpr1', virtual-reg: '%1' }
  - { reg: '$vgpr2', virtual-reg: '%2' }
  - { reg: '$vgpr3', virtual-reg: '%3' }
  - { reg: '$vgpr4', virtual-reg: '%4' }
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4

    ; W32: [[PHI:%[0-9]+]]:sreg_32_xm0_xexec = PHI %{{[0-9]+}}, %bb.0, [[NEWEXEC:%[0-9]+]], %bb.2
    ; W32: BUFFER_LOAD_FORMAT_X_IDXEN
    ; W32-NEXT: [[NEWEXEC]]:sreg_32_xm0_xexec = S_ANDN2_WREXEC_B32_term [[PHI]], implicit-def $exec, implicit-def $scc, implicit $exec
    ; W32-NEXT: SI_WATERFALL_LOOP %bb.1, implicit $exec

    ; W64: [[PHI:%[0-9]+]]:sreg_64_xexec = PHI %{{[0-9]+}}, %bb.0, [[NEWEXEC:%[0-9]+]], %bb.2
    ; W64: BUFFER_LOAD_FORMAT_X_IDXEN
    ; W64-NEXT: [[NEWEXEC]]:sreg_64_xexec = S_ANDN2_WREXEC_B64_term [[PHI]], implicit-def $exec, implicit-def $scc, implicit $exec
    ; W64-NEXT: SI_WATERFALL_LOOP %bb.1, implicit $exec

    ; PHIELIM32: bb.1:
    ; PHIELIM32: [[PHI:%[0-9]+]]:sreg_32_xm0_xexec = COPY killed [[NEWEXEC:%[0-9]+]]
    ; PHIELIM32: bb.2:
    ; PHIELIM32: BUFFER_LOAD_FORMAT_X_IDXEN
    ; PHIELIM32-NEXT: [[NEWEXEC]]:sreg_32_xm0_xexec = S_ANDN2_WREXEC_B32_term killed [[PHI]], implicit-def $exec, implicit-def dead $scc, implicit $exec
    ; PHIELIM32-NEXT: SI_WATERFALL_LOOP %bb.1, implicit $exec

    ; PHIELIM64: bb.1:
    ; PHIELIM64: [[PHI:%[0-9]+]]:sreg_64_xexec = COPY killed [[NEWEXEC:%[0-9]+]]
    ; PHIELIM64: bb.2:
    ; PHIELIM64: BUFFER_LOAD_FORMAT_X_IDXEN
    ; PHIELIM64-NEXT: [[NEWEXEC]]:sreg_64_xexec = S_ANDN2_WREXEC_B64_term killed [[PHI]], implicit-def $exec, implicit-def dead $scc, implicit $exec
    ; PHIELIM64-NEXT: SI_WATERFALL_LOOP %bb.1, implicit $exec
    %4:vgpr_32 = COPY $vgpr4
    %3:vgpr_32 = COPY $vgpr3
    %2:vgpr_32 = COPY $vgpr2
    %1:vgpr_32 = COPY $vgpr1
    %0:vgpr_32 = COPY $vgpr0
    %5:sgpr_128 = REG_SEQUENCE %0, %subreg.sub0, %1, %subreg.sub1, %2, %subreg.sub2, %3, %subreg.sub3
    %6:vgpr_32 = BUFFER_LOAD_FORMAT_X_IDXEN %4, killed %5, 0, 0, 0, 0, implicit $exec
    $vgpr0 = COPY %6
    S_ENDPGM 0, implicit $vgpr0
...
