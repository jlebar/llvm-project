# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass=si-fold-operands -verify-machineinstrs %s -o - | FileCheck %s

# On GFX12 V_ADD_CO_U32 and V_SUB_CO_U32 are VOP3-only. Folding the abs64
# global into the add is not legal in either source position, and the fold
# must not shrink the instruction to the nonexistent e32 form.

--- |
  @sym = external constant i32
  define void @fold_global_no_shrink_add() { ret void }
  define void @fold_global_no_shrink_sub() { ret void }
...
---
name: fold_global_no_shrink_add
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fold_global_no_shrink_add
    ; CHECK: [[DEF:%[0-9]+]]:vreg_64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[S_MOV_B64_:%[0-9]+]]:sreg_64 = S_MOV_B64 target-flags(amdgpu-abs64) @sym
    ; CHECK-NEXT: [[V_ADD_CO_U32_e64_:%[0-9]+]]:vgpr_32, [[V_ADD_CO_U32_e64_1:%[0-9]+]]:sreg_32_xm0_xexec = V_ADD_CO_U32_e64 undef [[S_MOV_B64_]].sub0, undef [[DEF]].sub0, 0, implicit $exec
    ; CHECK-NEXT: S_NOP 0, implicit [[V_ADD_CO_U32_e64_]]
    %0:vreg_64 = IMPLICIT_DEF
    %1:sreg_64 = S_MOV_B64 target-flags(amdgpu-abs64) @sym
    %2:vgpr_32, %3:sreg_32_xm0_xexec = V_ADD_CO_U32_e64 undef %1.sub0, undef %0.sub0, 0, implicit $exec
    S_NOP 0, implicit %2
...
---
name: fold_global_no_shrink_sub
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: fold_global_no_shrink_sub
    ; CHECK: [[DEF:%[0-9]+]]:vreg_64 = IMPLICIT_DEF
    ; CHECK-NEXT: [[S_MOV_B64_:%[0-9]+]]:sreg_64 = S_MOV_B64 target-flags(amdgpu-abs64) @sym
    ; CHECK-NEXT: [[V_SUB_CO_U32_e64_:%[0-9]+]]:vgpr_32, [[V_SUB_CO_U32_e64_1:%[0-9]+]]:sreg_32_xm0_xexec = V_SUB_CO_U32_e64 undef [[S_MOV_B64_]].sub0, undef [[DEF]].sub0, 0, implicit $exec
    ; CHECK-NEXT: S_NOP 0, implicit [[V_SUB_CO_U32_e64_]]
    %0:vreg_64 = IMPLICIT_DEF
    %1:sreg_64 = S_MOV_B64 target-flags(amdgpu-abs64) @sym
    %2:vgpr_32, %3:sreg_32_xm0_xexec = V_SUB_CO_U32_e64 undef %1.sub0, undef %0.sub0, 0, implicit $exec
    S_NOP 0, implicit %2
...
