# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 -run-pass=register-coalescer -verify-machineinstrs -o - %s | FileCheck %s

# adjustCopiesBackFrom eliminates the second copy of a pair
#   %4 = COPY %221
#   %221 = COPY %4
# by extending %221's previous value over the gap and merging the two value
# numbers, lane by lane. %221's previous value only defines some lanes
# (bb.0 fills sub4-sub14 and sub28-sub31; the rest come from IMPLICIT_DEFs
# merged in through bb.4), so the lanes that are live at the second copy but
# have no value at the first crashed the per-lane merge with a null VNInfo.
#
# This is llvm-reduce output from a fuzzed HIP kernel and is sensitive to the
# coalescer's processing order: the copy chain in bb.4 must be joined first
# so that %221 reaches the failing pair with exactly these subranges.
#
# The pair must survive: eliminating the second copy would leave the lanes
# that have no pre-copy value with a value number defined at the erased copy.
# CHECK: [[A:%[0-9]+]]:vreg_1024_align2 = COPY [[B:%[0-9]+]]
# CHECK-NEXT: [[B]]:vreg_1024_align2 = COPY [[A]]

---
name:            _Z2k0PVdPDv2_sxx
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $vgpr0, $sgpr4_sgpr5
  
    %612:sreg_64_xexec = IMPLICIT_DEF
    %613:sreg_32 = IMPLICIT_DEF
    %614:vreg_64_align2 = IMPLICIT_DEF
    %44:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %46:vgpr_32, killed undef %612, implicit $exec
    %50:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %52:vgpr_32, killed undef %612, implicit $exec
    %56:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %58:vgpr_32, killed undef %612, implicit $exec
    %62:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %64:vgpr_32, killed undef %612, implicit $exec
    %146:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %148:vgpr_32, killed undef %612, implicit $exec
    %152:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %154:vgpr_32, killed undef %612, implicit $exec
    %158:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %160:vgpr_32, killed undef %612, implicit $exec
    %164:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %166:vgpr_32, killed undef %612, implicit $exec
    %170:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %172:vgpr_32, killed undef %612, implicit $exec
    %176:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %178:vgpr_32, killed undef %612, implicit $exec
    %182:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %184:vgpr_32, killed undef %612, implicit $exec
    %188:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %190:vgpr_32, killed undef %612, implicit $exec
    %194:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, undef %196:vgpr_32, killed undef %612, implicit $exec
    %200:vgpr_32 = IMPLICIT_DEF
    %206:vgpr_32 = IMPLICIT_DEF
    undef %221.sub4:vreg_1024_align2 = COPY killed %206
    %221.sub5:vreg_1024_align2 = COPY killed %200
    %221.sub6:vreg_1024_align2 = COPY killed %194
    %221.sub7:vreg_1024_align2 = COPY killed %188
    %221.sub8:vreg_1024_align2 = COPY killed %182
    %221.sub9:vreg_1024_align2 = COPY killed %176
    %221.sub10:vreg_1024_align2 = COPY killed %170
    %221.sub11:vreg_1024_align2 = COPY killed %164
    %221.sub12:vreg_1024_align2 = COPY killed %158
    %221.sub13:vreg_1024_align2 = COPY killed %152
    %221.sub14:vreg_1024_align2 = COPY killed %146
    %221.sub28:vreg_1024_align2 = COPY killed %62
    %221.sub29:vreg_1024_align2 = COPY killed %56
    %221.sub30:vreg_1024_align2 = COPY killed %50
    %221.sub31:vreg_1024_align2 = COPY killed %44
    S_CBRANCH_VCCNZ %bb.2, implicit killed undef $vcc
    S_BRANCH %bb.1
  
  bb.1:
    successors: %bb.2(0x80000000)
  
  bb.2:
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
  
    %2:av_1024_align2 = COPY undef %221
    %585:av_1024_align2 = COPY killed %2
    S_CBRANCH_SCC1 %bb.4, implicit killed undef $scc
    S_BRANCH %bb.3
  
  bb.3:
    successors: %bb.4(0x80000000)
  
    %229:vreg_1024_align2 = COPY killed %221
    %4:vreg_1024_align2 = COPY killed %229
    %585:av_1024_align2 = COPY killed %4
  
  bb.4:
    successors: %bb.6(0x80000000)
  
    %236:av_1024_align2 = COPY killed %585
