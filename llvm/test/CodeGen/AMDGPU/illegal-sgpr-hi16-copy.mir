# RUN: not llc -mtriple=amdgcn -mcpu=gfx1100 -mattr=+real-true16 -run-pass=postrapseudos -o /dev/null %s 2>&1 | FileCheck %s
# RUN: not llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=postrapseudos -o /dev/null %s 2>&1 | FileCheck %s

# The high halves of SGPRs are artificial registers with no register class;
# there is no instruction that can read them. copyPhysReg used to dereference
# the null register class and crash; check that it reports an error instead.

# CHECK: error: {{.*}} in function illegal_sgpr_hi16_copy void (): illegal copy of artificial register

---
name: illegal_sgpr_hi16_copy
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr5
    renamable $vgpr4_lo16 = COPY renamable $sgpr5_hi16, implicit $exec
    S_ENDPGM 0
...
