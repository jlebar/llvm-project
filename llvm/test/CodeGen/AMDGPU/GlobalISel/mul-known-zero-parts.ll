; CHECK-NEXT:    v_mad_u64_u32 v[12:13], vcc, v6, v3, v[10:11]
; CHECK-NEXT:    v_mad_u64_u32 v[6:7], s[4:5], v14, v3, v[8:9]
; CHECK-NEXT:    v_cndmask_b32_e64 v5, 0, 1, s[4:5]
