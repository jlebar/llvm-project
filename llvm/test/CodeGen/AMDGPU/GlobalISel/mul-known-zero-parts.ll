; RUN: llc -global-isel -mtriple=amdgcn -mcpu=gfx90a < %s | FileCheck %s

; On subtargets with full-rate 64-bit ops the odd-aligned partial products are
; computed separately. Squaring a zero-extended i64 leaves every partial
; product at the highest odd offset known-zero, so buildMadChain skips them
; all and used to hand a null register to the final add.
define i128 @v_mul_i128_zext_square(i64 %x) {
; CHECK-LABEL: v_mul_i128_zext_square:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
; CHECK-NEXT:    v_mov_b32_e32 v2, v0
; CHECK-NEXT:    v_mov_b32_e32 v3, v1
; CHECK-NEXT:    v_mad_u64_u32 v[6:7], s[4:5], v2, v3, 0
; CHECK-NEXT:    v_mad_u64_u32 v[0:1], s[4:5], v2, v2, 0
; CHECK-NEXT:    v_mad_u64_u32 v[4:5], s[4:5], v3, v3, 0
; CHECK-NEXT:    v_mad_u64_u32 v[8:9], vcc, v3, v2, v[6:7]
; CHECK-NEXT:    v_add_co_u32_e64 v1, s[4:5], v1, v8
; CHECK-NEXT:    v_addc_co_u32_e64 v2, s[4:5], v4, v9, s[4:5]
; CHECK-NEXT:    v_addc_co_u32_e64 v3, s[4:5], 0, v5, s[4:5]
; CHECK-NEXT:    v_addc_co_u32_e32 v3, vcc, 0, v3, vcc
; CHECK-NEXT:    s_setpc_b64 s[30:31]
  %ext = zext i64 %x to i128
  %m = mul i128 %ext, %ext
  ret i128 %m
}

