# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Fusing SHIFT(SHIFT(%base, C1), C2) into SHIFT(%base, C1+C2) must not keep
# the outer shift's exact/nuw/nsw: they described shifting the inner shift's
# result, whose discarded bits of %base the fused shift now sees directly.

---
name: lshr_exact_chain
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: lshr_exact_chain
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 2
    ; CHECK-NEXT: [[LSHR:%[0-9]+]]:_(s32) = G_LSHR [[COPY]], [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[LSHR]](s32)
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s32) = G_LSHR %0, %1
    %3:_(s32) = exact G_LSHR %2, %1
    $vgpr0 = COPY %3
...
---
name: shl_nuw_nsw_chain
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: shl_nuw_nsw_chain
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 2
    ; CHECK-NEXT: [[SHL:%[0-9]+]]:_(s32) = G_SHL [[COPY]], [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[SHL]](s32)
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s32) = G_SHL %0, %1
    %3:_(s32) = nuw nsw G_SHL %2, %1
    $vgpr0 = COPY %3
...
---
name: ashr_exact_chain
body: |
  bb.0:
    liveins: $vgpr0
    ; CHECK-LABEL: name: ashr_exact_chain
    ; CHECK: liveins: $vgpr0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 4
    ; CHECK-NEXT: [[ASHR:%[0-9]+]]:_(s32) = G_ASHR [[COPY]], [[C]](s32)
    ; CHECK-NEXT: $vgpr0 = COPY [[ASHR]](s32)
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 2
    %2:_(s32) = G_ASHR %0, %1
    %3:_(s32) = exact G_ASHR %2, %1
    $vgpr0 = COPY %3
...
