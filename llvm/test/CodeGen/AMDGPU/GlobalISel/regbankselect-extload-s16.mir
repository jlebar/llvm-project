# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -mattr=+real-true16 -run-pass='amdgpu-regbankselect,amdgpu-regbanklegalize' %s -verify-machineinstrs -o - | FileCheck -check-prefixes=GFX11 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -run-pass='amdgpu-regbankselect,amdgpu-regbanklegalize' %s -verify-machineinstrs -o - | FileCheck -check-prefixes=GFX12 %s

# On true16 targets zero- and sign-extending loads of i8 with an s16 result
# are legal. Uniform ones use a scalar load: s_load_{u8|i8} where available
# (gfx12), otherwise a widened 32-bit load with and/sext-inreg (gfx11).
# Loads that don't qualify for SMEM go through a vgpr load + readanylane.

--- |
  @gv = external addrspace(1) global i8
  @lds = external addrspace(3) global i8

  define void @zextload_s16_p1_uniform() { ret void }
  define void @sextload_s16_p1_uniform() { ret void }
  define void @sextload_s16_p1_uniform_volatile() { ret void }
  define void @zextload_s16_p4_uniform() { ret void }
  define void @sextload_s16_p3_uniform() { ret void }
...
---
name: zextload_s16_p1_uniform
legalized: true

body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    ; GFX11-LABEL: name: zextload_s16_p1_uniform
    ; GFX11: liveins: $sgpr0_sgpr1
    ; GFX11-NEXT: {{  $}}
    ; GFX11-NEXT: [[COPY:%[0-9]+]]:sgpr(p1) = COPY $sgpr0_sgpr1
    ; GFX11-NEXT: [[ZEXTLOAD:%[0-9]+]]:vgpr(s16) = G_ZEXTLOAD [[COPY]](p1) :: (invariant load (s8) from @gv, addrspace 1)
    ; GFX11-NEXT: [[ANYEXT:%[0-9]+]]:vgpr(s32) = G_ANYEXT [[ZEXTLOAD]](s16)
    ; GFX11-NEXT: [[AMDGPU_READANYLANE:%[0-9]+]]:sgpr(s32) = G_AMDGPU_READANYLANE [[ANYEXT]]
    ; GFX11-NEXT: [[TRUNC:%[0-9]+]]:sgpr(s16) = G_TRUNC [[AMDGPU_READANYLANE]](s32)
    ; GFX11-NEXT: S_ENDPGM 0, implicit [[TRUNC]](s16)
    ;
    ; GFX12-LABEL: name: zextload_s16_p1_uniform
    ; GFX12: liveins: $sgpr0_sgpr1
    ; GFX12-NEXT: {{  $}}
    ; GFX12-NEXT: [[COPY:%[0-9]+]]:sgpr(p1) = COPY $sgpr0_sgpr1
    ; GFX12-NEXT: [[ZEXTLOAD:%[0-9]+]]:sgpr(s32) = G_ZEXTLOAD [[COPY]](p1) :: (invariant load (s8) from @gv, addrspace 1)
    ; GFX12-NEXT: [[TRUNC:%[0-9]+]]:sgpr(s16) = G_TRUNC [[ZEXTLOAD]](s32)
    ; GFX12-NEXT: S_ENDPGM 0, implicit [[TRUNC]](s16)
    %0:_(p1) = COPY $sgpr0_sgpr1
    %1:_(s16) = G_ZEXTLOAD %0 :: (invariant load (s8) from @gv, addrspace 1)
    S_ENDPGM 0, implicit %1
...

