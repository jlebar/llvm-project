# The phi is uniform inside the loop, but its use in the trunc past the SI_LOOP
# is divergent (temporal divergence): the value arrives through a vgpr COPY
# whose source def is uniform. The divergent-result trunc rule must not
# require the source to be divergent at its def.
---
name: trunc_i32_to_i16_temporal_divergent_src
legalized: true
tracksRegLiveness: true
body: |
  ; GFX-LABEL: name: trunc_i32_to_i16_temporal_divergent_src
  ; GFX: bb.0:
  ; GFX-NEXT:   successors: %bb.1(0x80000000)
  ; GFX-NEXT:   liveins: $vgpr0
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; GFX-NEXT:   [[C:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   [[COPY1:%[0-9]+]]:vgpr(s32) = COPY [[C]](s32)
  ; GFX-NEXT:   [[ICMP:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY]](s32), [[COPY1]]
  ; GFX-NEXT:   [[C1:%[0-9]+]]:sgpr(s64) = G_CONSTANT i64 0
  ; GFX-NEXT:   [[C2:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 1
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT: bb.1:
  ; GFX-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT:   [[PHI:%[0-9]+]]:sgpr(s64) = G_PHI %13(s64), %bb.1, [[C1]](s64), %bb.0
  ; GFX-NEXT:   [[PHI1:%[0-9]+]]:sgpr(s32) = G_PHI [[C2]](s32), %bb.0, %8(s32), %bb.1
  ; GFX-NEXT:   [[COPY2:%[0-9]+]]:vgpr(s32) = COPY [[PHI1]](s32), implicit $exec
  ; GFX-NEXT:   [[INT:%[0-9]+]]:sgpr(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), [[ICMP]](s1), [[PHI]](s64)
  ; GFX-NEXT:   [[COPY3:%[0-9]+]]:sreg_64_xexec(s64) = COPY [[INT]](s64)
  ; GFX-NEXT:   [[C3:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   SI_LOOP [[COPY3]](s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
  ; GFX-NEXT:   G_BR %bb.2
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT: bb.2:
  ; GFX-NEXT:   [[TRUNC:%[0-9]+]]:vgpr(s16) = G_TRUNC [[COPY2]](s32)
  ; GFX-NEXT:   [[ANYEXT:%[0-9]+]]:vgpr(s32) = G_ANYEXT [[TRUNC]](s16)
  ; GFX-NEXT:   [[DEF:%[0-9]+]]:sgpr(p1) = G_IMPLICIT_DEF
  ; GFX-NEXT:   G_STORE [[ANYEXT]](s32), [[DEF]](p1) :: (store (s16), addrspace 1)
  ; GFX-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:_(s64) = G_CONSTANT i64 0
    %4:_(s32) = G_CONSTANT i32 1

  bb.1:
    successors: %bb.2, %bb.1
    %5:_(s64) = G_PHI %7(s64), %bb.1, %3(s64), %bb.0
    %6:_(s32) = G_PHI %4(s32), %bb.0, %8(s32), %bb.1
    %9:_(s32) = COPY %6(s32), implicit $exec
    %7:sreg_64_xexec(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), %2(s1), %5(s64)
    %8:_(s32) = G_CONSTANT i32 0
    SI_LOOP %7(s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
    G_BR %bb.2

  bb.2:
    %10:_(s16) = G_TRUNC %9(s32)
    %11:_(s32) = G_ANYEXT %10(s16)
    %12:_(p1) = G_IMPLICIT_DEF
    G_STORE %11(s32), %12(p1) :: (store (s16), addrspace 1)
    S_ENDPGM 0
...

# Same, but truncating to s1, exercising the DivS1 VgprToVccCopy rule.
---
name: trunc_i32_to_i1_temporal_divergent_src
legalized: true
tracksRegLiveness: true
body: |
  ; GFX-LABEL: name: trunc_i32_to_i1_temporal_divergent_src
  ; GFX: bb.0:
  ; GFX-NEXT:   successors: %bb.1(0x80000000)
  ; GFX-NEXT:   liveins: $vgpr0
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; GFX-NEXT:   [[C:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   [[COPY1:%[0-9]+]]:vgpr(s32) = COPY [[C]](s32)
  ; GFX-NEXT:   [[ICMP:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY]](s32), [[COPY1]]
  ; GFX-NEXT:   [[C1:%[0-9]+]]:sgpr(s64) = G_CONSTANT i64 0
  ; GFX-NEXT:   [[C2:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 1
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT: bb.1:
  ; GFX-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT:   [[PHI:%[0-9]+]]:sgpr(s64) = G_PHI %13(s64), %bb.1, [[C1]](s64), %bb.0
  ; GFX-NEXT:   [[PHI1:%[0-9]+]]:sgpr(s32) = G_PHI [[C2]](s32), %bb.0, %8(s32), %bb.1
  ; GFX-NEXT:   [[COPY2:%[0-9]+]]:vgpr(s32) = COPY [[PHI1]](s32), implicit $exec
  ; GFX-NEXT:   [[INT:%[0-9]+]]:sgpr(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), [[ICMP]](s1), [[PHI]](s64)
  ; GFX-NEXT:   [[COPY3:%[0-9]+]]:sreg_64_xexec(s64) = COPY [[INT]](s64)
  ; GFX-NEXT:   [[C3:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   SI_LOOP [[COPY3]](s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
  ; GFX-NEXT:   G_BR %bb.2
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT: bb.2:
  ; GFX-NEXT:   [[C4:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 1
  ; GFX-NEXT:   [[AND:%[0-9]+]]:vgpr(s32) = G_AND [[COPY2]], [[C4]]
  ; GFX-NEXT:   [[C5:%[0-9]+]]:vgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   [[ICMP1:%[0-9]+]]:vcc(s1) = G_ICMP intpred(ne), [[AND]](s32), [[C5]]
  ; GFX-NEXT:   [[SELECT:%[0-9]+]]:vgpr(s32) = G_SELECT [[ICMP1]](s1), [[C4]], [[C5]]
  ; GFX-NEXT:   [[DEF:%[0-9]+]]:sgpr(p1) = G_IMPLICIT_DEF
  ; GFX-NEXT:   G_STORE [[SELECT]](s32), [[DEF]](p1) :: (store (s32), addrspace 1)
  ; GFX-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:_(s64) = G_CONSTANT i64 0
    %4:_(s32) = G_CONSTANT i32 1

  bb.1:
    successors: %bb.2, %bb.1
    %5:_(s64) = G_PHI %7(s64), %bb.1, %3(s64), %bb.0
    %6:_(s32) = G_PHI %4(s32), %bb.0, %8(s32), %bb.1
    %9:_(s32) = COPY %6(s32), implicit $exec
    %7:sreg_64_xexec(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), %2(s1), %5(s64)
    %8:_(s32) = G_CONSTANT i32 0
    SI_LOOP %7(s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
    G_BR %bb.2

  bb.2:
    %10:_(s1) = G_TRUNC %9(s32)
    %11:_(s32) = G_ZEXT %10(s1)
    %12:_(p1) = G_IMPLICIT_DEF
    G_STORE %11(s32), %12(p1) :: (store (s32), addrspace 1)
    S_ENDPGM 0
...
