# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=fiji -run-pass="amdgpu-regbankselect,amdgpu-regbanklegalize" %s -verify-machineinstrs -o - | FileCheck -check-prefix=GFX %s

# The loop counter phi is uniform at its def, but its use past the SI_LOOP is
# divergent (temporal divergence): different lanes leave the loop on different
# iterations, so past the loop each lane holds its own copy of the value. The
# value arrives through a vgpr COPY with an implicit use of $exec. The rules
# for the vector-element index must treat it as divergent and pick the
# compare+select lowering, not the scalar-index Sgpr32 mapping.

---
name: insert_vector_elt_v4i32_temporal_divergent_idx
legalized: true
tracksRegLiveness: true
body: |
  ; GFX-LABEL: name: insert_vector_elt_v4i32_temporal_divergent_idx
  ; GFX: bb.0:
  ; GFX-NEXT:   successors: %bb.1(0x80000000)
  ; GFX-NEXT:   liveins: $vgpr0, $vgpr1
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; GFX-NEXT:   [[COPY1:%[0-9]+]]:vgpr(s32) = COPY $vgpr1
  ; GFX-NEXT:   [[C:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   [[COPY2:%[0-9]+]]:vgpr(s32) = COPY [[C]](s32)
  ; GFX-NEXT:   [[ICMP:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY]](s32), [[COPY2]]
  ; GFX-NEXT:   [[C1:%[0-9]+]]:sgpr(s64) = G_CONSTANT i64 0
  ; GFX-NEXT:   [[C2:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 1
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT: bb.1:
  ; GFX-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT:   [[PHI:%[0-9]+]]:sgpr(s64) = G_PHI %14(s64), %bb.1, [[C1]](s64), %bb.0
  ; GFX-NEXT:   [[PHI1:%[0-9]+]]:sgpr(s32) = G_PHI [[C2]](s32), %bb.0, %9(s32), %bb.1
  ; GFX-NEXT:   [[COPY3:%[0-9]+]]:vgpr(s32) = COPY [[PHI1]](s32), implicit $exec
  ; GFX-NEXT:   [[INT:%[0-9]+]]:sgpr(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), [[ICMP]](s1), [[PHI]](s64)
  ; GFX-NEXT:   [[COPY4:%[0-9]+]]:sreg_64_xexec(s64) = COPY [[INT]](s64)
  ; GFX-NEXT:   [[C3:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   SI_LOOP [[COPY4]](s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
  ; GFX-NEXT:   G_BR %bb.2
  ; GFX-NEXT: {{  $}}
  ; GFX-NEXT: bb.2:
  ; GFX-NEXT:   [[BUILD_VECTOR:%[0-9]+]]:vgpr(<4 x s32>) = G_BUILD_VECTOR [[COPY1]](s32), [[COPY1]](s32), [[COPY1]](s32), [[COPY1]](s32)
  ; GFX-NEXT:   [[UV:%[0-9]+]]:vgpr(s32), [[UV1:%[0-9]+]]:vgpr(s32), [[UV2:%[0-9]+]]:vgpr(s32), [[UV3:%[0-9]+]]:vgpr(s32) = G_UNMERGE_VALUES [[BUILD_VECTOR]](<4 x s32>)
  ; GFX-NEXT:   [[C4:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; GFX-NEXT:   [[ICMP1:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY3]](s32), [[C4]]
  ; GFX-NEXT:   [[SELECT:%[0-9]+]]:vgpr(s32) = G_SELECT [[ICMP1]](s1), [[COPY1]], [[UV]]
  ; GFX-NEXT:   [[C5:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 1
  ; GFX-NEXT:   [[ICMP2:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY3]](s32), [[C5]]
  ; GFX-NEXT:   [[SELECT1:%[0-9]+]]:vgpr(s32) = G_SELECT [[ICMP2]](s1), [[COPY1]], [[UV1]]
  ; GFX-NEXT:   [[C6:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 2
  ; GFX-NEXT:   [[ICMP3:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY3]](s32), [[C6]]
  ; GFX-NEXT:   [[SELECT2:%[0-9]+]]:vgpr(s32) = G_SELECT [[ICMP3]](s1), [[COPY1]], [[UV2]]
  ; GFX-NEXT:   [[C7:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 3
  ; GFX-NEXT:   [[ICMP4:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY3]](s32), [[C7]]
  ; GFX-NEXT:   [[SELECT3:%[0-9]+]]:vgpr(s32) = G_SELECT [[ICMP4]](s1), [[COPY1]], [[UV3]]
  ; GFX-NEXT:   [[BUILD_VECTOR1:%[0-9]+]]:vgpr(<4 x s32>) = G_BUILD_VECTOR [[SELECT]](s32), [[SELECT1]](s32), [[SELECT2]](s32), [[SELECT3]](s32)
  ; GFX-NEXT:   [[DEF:%[0-9]+]]:sgpr(p1) = G_IMPLICIT_DEF
  ; GFX-NEXT:   G_STORE [[BUILD_VECTOR1]](<4 x s32>), [[DEF]](p1) :: (store (<4 x s32>), addrspace 1)
  ; GFX-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_CONSTANT i32 0
    %3:_(s1) = G_ICMP intpred(eq), %0(s32), %2
    %4:_(s64) = G_CONSTANT i64 0
    %5:_(s32) = G_CONSTANT i32 1

  bb.1:
    successors: %bb.2, %bb.1
    %6:_(s64) = G_PHI %8(s64), %bb.1, %4(s64), %bb.0
    %7:_(s32) = G_PHI %5(s32), %bb.0, %9(s32), %bb.1
    %10:_(s32) = COPY %7(s32), implicit $exec
    %8:sreg_64_xexec(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), %3(s1), %6(s64)
    %9:_(s32) = G_CONSTANT i32 0
    SI_LOOP %8(s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
    G_BR %bb.2

  bb.2:
    %11:_(<4 x s32>) = G_BUILD_VECTOR %1(s32), %1(s32), %1(s32), %1(s32)
    %12:_(<4 x s32>) = G_INSERT_VECTOR_ELT %11, %1(s32), %10(s32)
    %13:_(p1) = G_IMPLICIT_DEF
    G_STORE %12(<4 x s32>), %13(p1) :: (store (<4 x s32>), addrspace 1)
    S_ENDPGM 0
...

