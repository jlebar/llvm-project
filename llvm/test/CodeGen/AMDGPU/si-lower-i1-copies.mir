# The SCC value consumed by the terminator of bb.1 is defined at the top of
# the block, above the def of the incoming lane mask. The merge cannot be
# inserted above the S_CMP (it would be above the V_CMP def), so it goes
# before the terminator with SCC saved and restored around it.
name:              lcssa_phi_scc_def_far_from_terminator
tracksRegLiveness: true
body:             |
  ; GCN-LABEL: name: lcssa_phi_scc_def_far_from_terminator
  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT:   liveins: $vgpr0, $sgpr0
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; GCN-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; GCN-NEXT:   [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
  ; GCN-NEXT:   S_BRANCH %bb.1
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[PHI:%[0-9]+]]:sreg_64 = PHI [[DEF]], %bb.0, %4, %bb.1
  ; GCN-NEXT:   S_CMP_LG_U32 [[COPY]], 0, implicit-def $scc
  ; GCN-NEXT:   [[V_CMP_LT_I32_e64_:%[0-9]+]]:sreg_64 = V_CMP_LT_I32_e64 [[COPY1]], 0, implicit $exec
  ; GCN-NEXT:   [[S_CSELECT_B32_:%[0-9]+]]:sreg_32 = S_CSELECT_B32 1, 0, implicit $scc
  ; GCN-NEXT:   [[S_ANDN2_B64_:%[0-9]+]]:sreg_64 = S_ANDN2_B64 [[PHI]], $exec, implicit-def $scc
  ; GCN-NEXT:   [[S_AND_B64_:%[0-9]+]]:sreg_64 = S_AND_B64 [[V_CMP_LT_I32_e64_]], $exec, implicit-def $scc
  ; GCN-NEXT:   [[S_OR_B64_:%[0-9]+]]:sreg_64 = S_OR_B64 [[S_ANDN2_B64_]], [[S_AND_B64_]], implicit-def $scc
  ; GCN-NEXT:   S_CMP_LG_U32 killed [[S_CSELECT_B32_]], 0, implicit-def $scc
  ; GCN-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; GCN-NEXT:   S_BRANCH %bb.2
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.2:
  ; GCN-NEXT:   [[COPY2:%[0-9]+]]:sreg_64 = COPY [[S_OR_B64_]]
  ; GCN-NEXT:   S_ENDPGM 0, implicit [[COPY2]]
  bb.0:
    liveins: $vgpr0, $sgpr0
    %0:sreg_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    S_BRANCH %bb.1

  bb.1:
    S_CMP_LG_U32 %0, 0, implicit-def $scc
    %2:sreg_64 = V_CMP_LT_I32_e64 %1, 0, implicit $exec
    %3:vreg_1 = COPY %2
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    %4:vreg_1 = PHI %3, %bb.1
    %5:sreg_64 = COPY %4
    S_ENDPGM 0, implicit %5

