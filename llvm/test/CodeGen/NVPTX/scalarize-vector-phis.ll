; CHECK-NEXT:    [[P_0:%.*]] = phi float [ [[A]], %[[QBLOCK]] ], [ 0.000000e+00, %[[QBLOCK2:.*]] ]
; CHECK-NEXT:    [[P_1:%.*]] = phi float [ [[B]], %[[QBLOCK]] ], [ 0.000000e+00, %[[QBLOCK2]] ]
; CHECK-NEXT:    ret float [[P_0]]
; CHECK:       [[QBLOCK]]:
; CHECK-NEXT:    br i1 [[C]], label %[[MERGE]], label %[[QBLOCK2]]
; CHECK:       [[QBLOCK2]]:
