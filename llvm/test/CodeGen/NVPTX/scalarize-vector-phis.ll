; CHECK-NEXT:    [[CYC0:%.*]] = insertelement <2 x float> [[CYC1:%.*]], float [[A]], i64 0
; CHECK-NEXT:    [[CYC1]] = insertelement <2 x float> [[CYC0]], float [[A]], i64 1
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[V:%.*]] = phi <2 x float> [ zeroinitializer, %[[ENTRY]] ], [ [[CYC1]], %[[DEAD]] ]
; CHECK-NEXT:    [[LO:%.*]] = extractelement <2 x float> [[V]], i64 0
; CHECK-NEXT:    ret float [[LO]]
;
entry:
  br label %merge

dead:
  %cyc0 = insertelement <2 x float> %cyc1, float %a, i64 0
  %cyc1 = insertelement <2 x float> %cyc0, float %a, i64 1
  br label %merge

merge:
  %v = phi <2 x float> [ zeroinitializer, %entry ], [ %cyc1, %dead ]
  %lo = extractelement <2 x float> %v, i64 0
  ret float %lo
}

; Negative test: optnone functions are not touched (the legacy PM skips via
; skipFunction, the new PM via the optnone pass instrumentation).
define float @optnone_phi(<2 x float> %init, i1 %c) noinline optnone {
; CHECK-LABEL: define float @optnone_phi(
; CHECK-SAME: <2 x float> [[INIT:%.*]], i1 [[C:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[ACC:%.*]] = phi <2 x float> [ [[INIT]], %[[ENTRY]] ], [ [[NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[LO:%.*]] = extractelement <2 x float> [[ACC]], i64 0
; CHECK-NEXT:    [[HI:%.*]] = extractelement <2 x float> [[ACC]], i64 1
; CHECK-NEXT:    [[S:%.*]] = fadd float [[LO]], [[HI]]
; CHECK-NEXT:    [[NEXT]] = insertelement <2 x float> [[ACC]], float [[S]], i64 0
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret float [[S]]
;
entry:
  br label %loop

loop:
  %acc = phi <2 x float> [ %init, %entry ], [ %next, %loop ]
  %lo = extractelement <2 x float> %acc, i64 0
  %hi = extractelement <2 x float> %acc, i64 1
  %s = fadd float %lo, %hi
  %next = insertelement <2 x float> %acc, float %s, i64 0
  br i1 %c, label %loop, label %exit

exit:
  ret float %s
}

; The chain feeding the PHI is built from the PHI's own extracts, and the
; chain head is also stored. The store's rebuilt vector must be wired to the
; values the extracts are replaced with (the scalar PHIs), not to the
; then-erased extracts themselves.
define void @chain_from_own_extracts(ptr %out, i1 %c) {
; CHECK-LABEL: define void @chain_from_own_extracts(
; CHECK-SAME: ptr [[OUT:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[P_0:%.*]] = phi float [ 0.000000e+00, %[[ENTRY]] ], [ [[P_0]], %[[LOOP]] ]
; CHECK-NEXT:    [[P_1:%.*]] = phi float [ 0.000000e+00, %[[ENTRY]] ], [ [[P_1]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <2 x float> poison, float [[P_0]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x float> [[TMP0]], float [[P_1]], i64 1
; CHECK-NEXT:    store <2 x float> [[TMP1]], ptr [[OUT]], align 8
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %p = phi <2 x float> [ zeroinitializer, %entry ], [ %chain1, %loop ]
  %lo = extractelement <2 x float> %p, i64 0
  %hi = extractelement <2 x float> %p, i64 1
  %chain0 = insertelement <2 x float> poison, float %lo, i64 0
  %chain1 = insertelement <2 x float> %chain0, float %hi, i64 1
  store <2 x float> %chain1, ptr %out
  br i1 %c, label %loop, label %exit

exit:
  ret void
}
