; A <2 x float> accumulator carried across a loop and only ever taken apart
; into scalars (for the wgmma.mma_async inline asm) and rebuilt from the asm
; results. The PHIs must be split into scalar PHIs so that the accumulator
; does not round-trip through a packed 64-bit register on every iteration.
; The vector is rebuilt right before the store, where unpacking is free.
define void @acc_loop_v2f32(ptr %out, i64 %desca, i64 %descb, i32 %n) {
; CHECK-LABEL: define void @acc_loop_v2f32(
; CHECK-SAME: ptr [[OUT:%.*]], i64 [[DESCA:%.*]], i64 [[DESCB:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC_0:%.*]] = phi float [ 0.000000e+00, %[[ENTRY]] ], [ [[R0:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC_1:%.*]] = phi float [ 0.000000e+00, %[[ENTRY]] ], [ [[R1:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[R:%.*]] = call { float, float } asm sideeffect "wgmma.mma_async.sync.aligned.m64n8k8.f32.f16.f16 {$0,$1}, $2, $3, 1, 1, 1
; CHECK-NEXT:    [[R0]] = extractvalue { float, float } [[R]], 0
; CHECK-NEXT:    [[R1]] = extractvalue { float, float } [[R]], 1
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ACC_LCSSA_0:%.*]] = phi float [ [[R0]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC_LCSSA_1:%.*]] = phi float [ [[R1]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = insertelement <2 x float> poison, float [[ACC_LCSSA_0]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x float> [[TMP0]], float [[ACC_LCSSA_1]], i64 1
; CHECK-NEXT:    store <2 x float> [[TMP1]], ptr [[OUT]], align 8
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi <2 x float> [ zeroinitializer, %entry ], [ %acc.next, %loop ]
  %lo = extractelement <2 x float> %acc, i64 0
  %hi = extractelement <2 x float> %acc, i64 1
  %r = call { float, float } asm sideeffect "wgmma.mma_async.sync.aligned.m64n8k8.f32.f16.f16 {$0,$1}, $2, $3, 1, 1, 1;", "=f,=f,l,l,0,1"(i64 %desca, i64 %descb, float %lo, float %hi)
  %r0 = extractvalue { float, float } %r, 0
  %r1 = extractvalue { float, float } %r, 1
  %v = insertelement <2 x float> poison, float %r0, i64 0
  %acc.next = insertelement <2 x float> %v, float %r1, i64 1
  %i.next = add i32 %i, 1
  %cmp = icmp slt i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  %acc.lcssa = phi <2 x float> [ %acc.next, %loop ]
  store <2 x float> %acc.lcssa, ptr %out
  ret void
}

