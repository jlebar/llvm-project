; The accumulator is initialized from memory rather than from constants: the
; initial lanes are extracted once in the preheader instead of unpacking the
; PHI on every iteration.
define void @warm_start_loop(ptr %out, ptr %init, i64 %desca, i64 %descb, i32 %n) {
; CHECK-LABEL: define void @warm_start_loop(
; CHECK-SAME: ptr [[OUT:%.*]], ptr [[INIT:%.*]], i64 [[DESCA:%.*]], i64 [[DESCB:%.*]], i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[C:%.*]] = load <2 x float>, ptr [[INIT]], align 8
; CHECK-NEXT:    [[TMP0:%.*]] = extractelement <2 x float> [[C]], i64 0
; CHECK-NEXT:    [[TMP1:%.*]] = extractelement <2 x float> [[C]], i64 1
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC_0:%.*]] = phi float [ [[TMP0]], %[[ENTRY]] ], [ [[R0:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC_1:%.*]] = phi float [ [[TMP1]], %[[ENTRY]] ], [ [[R1:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[R:%.*]] = call { float, float } asm sideeffect "wgmma.mma_async.sync.aligned.m64n8k8.f32.f16.f16 {$0,$1}, $2, $3, 1, 1, 1
; CHECK-NEXT:    [[R0]] = extractvalue { float, float } [[R]], 0
; CHECK-NEXT:    [[R1]] = extractvalue { float, float } [[R]], 1
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x float> poison, float [[R0]], i64 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <2 x float> [[TMP2]], float [[R1]], i64 1
; CHECK-NEXT:    store <2 x float> [[TMP3]], ptr [[OUT]], align 8
; CHECK-NEXT:    ret void
;
entry:
  %c = load <2 x float>, ptr %init
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi <2 x float> [ %c, %entry ], [ %acc.next, %loop ]
  %lo = extractelement <2 x float> %acc, i64 0
  %hi = extractelement <2 x float> %acc, i64 1
  %r = call { float, float } asm sideeffect "wgmma.mma_async.sync.aligned.m64n8k8.f32.f16.f16 {$0,$1}, $2, $3, 1, 1, 1;", "=f,=f,l,l,0,1"(i64 %desca, i64 %descb, float %lo, float %hi)
  %r0 = extractvalue { float, float } %r, 0
  %r1 = extractvalue { float, float } %r, 1
  %v = insertelement <2 x float> poison, float %r0, i64 0
  %acc.next = insertelement <2 x float> %v, float %r1, i64 1
  %i.next = add i32 %i, 1
  %cmp = icmp slt i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  store <2 x float> %acc.next, ptr %out
  ret void
}

