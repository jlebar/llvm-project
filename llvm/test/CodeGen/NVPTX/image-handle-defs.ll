; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mcpu=sm_50 -verify-machineinstrs | FileCheck %s
; RUN: %if ptxas %{ llc < %s -mcpu=sm_50 -verify-machineinstrs | %ptxas-verify %}

; The NVPTXReplaceImageHandles pass chases the definition of an image handle
; to try to replace it with a symbolic reference. Handles whose definitions
; cannot be folded away (a vectorized load of an aggregate kernel parameter, a
; phi of two handles, ...) must be preserved in their register form for CUDA
; instead of crashing or hanging the compiler (see #166167).

target triple = "nvptx64-nvidia-cuda"

%aggr = type { { i64, i64 }, <4 x i32> }

declare void @llvm.nvvm.sust.b.2d.v4i32.zero(i64, i32, i32, i32, i32, i32, i32)

; The handle is the first element of a vectorized param load (LDV_i64_v2).
define ptx_kernel void @handle_in_aggregate_first(%aggr %desc) {
; CHECK-LABEL: handle_in_aggregate_first(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ld.param.v2.b64 {%rd1, %rd2}, [handle_in_aggregate_first_param_0];
; CHECK-NEXT:    mov.b32 %r1, 0;
; CHECK-NEXT:    sust.b.2d.v4.b32.zero [%rd1, {%r1, %r1}], {%r1, %r1, %r1, %r1};
; CHECK-NEXT:    ret;
entry:
  %pair = extractvalue %aggr %desc, 0
  %handle = extractvalue { i64, i64 } %pair, 0
  tail call void @llvm.nvvm.sust.b.2d.v4i32.zero(i64 %handle, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0)
  ret void
}

; The handle is the second element of a vectorized param load.
define ptx_kernel void @handle_in_aggregate_second(%aggr %desc) {
; CHECK-LABEL: handle_in_aggregate_second(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ld.param.v2.b64 {%rd1, %rd2}, [handle_in_aggregate_second_param_0];
; CHECK-NEXT:    mov.b32 %r1, 0;
; CHECK-NEXT:    sust.b.2d.v4.b32.zero [%rd2, {%r1, %r1}], {%r1, %r1, %r1, %r1};
; CHECK-NEXT:    ret;
entry:
  %pair = extractvalue %aggr %desc, 0
  %handle = extractvalue { i64, i64 } %pair, 1
  tail call void @llvm.nvvm.sust.b.2d.v4i32.zero(i64 %handle, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0)
  ret void
}

; The handle is an element of a vector kernel parameter.
define ptx_kernel void @handle_in_vector_param(<4 x i64> %desc) {
; CHECK-LABEL: handle_in_vector_param(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ld.param.v2.b64 {%rd1, %rd2}, [handle_in_vector_param_param_0+16];
; CHECK-NEXT:    mov.b32 %r1, 0;
; CHECK-NEXT:    sust.b.2d.v4.b32.zero [%rd1, {%r1, %r1}], {%r1, %r1, %r1, %r1};
; CHECK-NEXT:    ret;
entry:
  %handle = extractelement <4 x i64> %desc, i32 2
  tail call void @llvm.nvvm.sust.b.2d.v4i32.zero(i64 %handle, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0)
  ret void
}

; The handle is a phi of two handles.
define ptx_kernel void @handle_phi(i64 %a, i64 %b, i1 %c) {
; CHECK-LABEL: handle_phi(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<2>;
; CHECK-NEXT:    .reg .b16 %rs<3>;
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0: // %entry
; CHECK-NEXT:    ld.param.b8 %rs1, [handle_phi_param_2];
; CHECK-NEXT:    and.b16 %rs2, %rs1, 1;
; CHECK-NEXT:    setp.ne.b16 %p1, %rs2, 0;
; CHECK-NEXT:    ld.param.b64 %rd1, [handle_phi_param_0];
; CHECK-NEXT:    @%p1 bra $L__BB3_2;
; CHECK-NEXT:  // %bb.1: // %else
; CHECK-NEXT:    ld.param.b64 %rd1, [handle_phi_param_1];
; CHECK-NEXT:  $L__BB3_2: // %join
; CHECK-NEXT:    mov.b32 %r1, 0;
; CHECK-NEXT:    sust.b.2d.v4.b32.zero [%rd1, {%r1, %r1}], {%r1, %r1, %r1, %r1};
; CHECK-NEXT:    ret;
entry:
  br i1 %c, label %join, label %else

else:
  br label %join

join:
  %handle = phi i64 [ %a, %entry ], [ %b, %else ]
  tail call void @llvm.nvvm.sust.b.2d.v4i32.zero(i64 %handle, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0)
  ret void
}
