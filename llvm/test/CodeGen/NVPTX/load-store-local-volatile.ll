; RUN: %if ptxas-sm_90 && ptxas-isa-9.1 %{ llc < %s -mtriple=nvptx64 -mcpu=sm_90 -mattr=+ptx91 | %ptxas-verify -arch=sm_90 %}

; PTX ISA 9.1 adds support for the .volatile qualifier on ld/st to the .local
; statespace. Check that volatile and atomic loads and stores to .local are
; lowered to ld.volatile/st.volatile instead of being demoted to weak memory
; operations, which would lose their forward progress guarantees. Atomic
; operations are lowered to volatile operations: no other thread can access a
; thread's .local memory, so no ordering stronger than relaxed is observable,
; and no fence is required.
;
; The pre-9.1 lowering of these operations (to weak memory operations) is
; tested in load-store-scalars.ll and load-store-sm-70.ll.

;; weak operations on .local must remain weak

define void @local_weak_i32(ptr addrspace(5) %a) {
; CHECK-LABEL: local_weak_i32(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<3>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [local_weak_i32_param_0];
; CHECK-NEXT:    ld.local.b32 %r1, [%rd1];
; CHECK-NEXT:    add.s32 %r2, %r1, 1;
; CHECK-NEXT:    st.local.b32 [%rd1], %r2;
; CHECK-NEXT:    ret;
  %a.load = load i32, ptr addrspace(5) %a
  %a.add = add i32 %a.load, 1
  store i32 %a.add, ptr addrspace(5) %a
  ret void
}

