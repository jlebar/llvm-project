;; byval parameters live in the local statespace. Volatile and atomic loads of
;; them cannot be forwarded to ld.param (the .param statespace does not
;; support the .volatile qualifier) and must access the local copy instead.

define i32 @byval_volatile(ptr byval(i32) %a) {
; CHECK-LABEL: byval_volatile(
; CHECK:       {
; CHECK-NEXT:    .reg .b32 %r<2>;
; CHECK-NEXT:    .reg .b64 %rd<2>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    mov.b64 %rd1, byval_volatile_param_0;
; CHECK-NEXT:    ld.volatile.local.b32 %r1, [%rd1];
; CHECK-NEXT:    st.param.b32 [func_retval0], %r1;
; CHECK-NEXT:    ret;
  %v = load volatile i32, ptr %a
  ret i32 %v
}

